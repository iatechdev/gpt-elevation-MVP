# Elevation — backend. Copia a .env en local. NUNCA pongas valores reales aquí.
# En Railway los valores se cargan como variables del servicio (los carga Mauricio).

NODE_ENV=production
# PORT lo asigna Railway; no se define.

# --- Base de datos (Supabase, pooler) ---
# Cadena de conexión del pooler: Supabase > Connect > Session pooler
DATABASE_URL=
DB_SSL=true
DB_POOL_MAX=5
# Solo en una base de desarrollo desechable: DB_SYNC_ALTER=true permite que sync() altere columnas.
# Sin esta variable (o con cualquier otro valor) sync() solo crea las tablas que falten. No definir en staging ni producción.
# DB_SYNC_ALTER
# Alternativa local sin DATABASE_URL:
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASS=

# --- Secretos de la aplicación (texto aleatorio largo, distinto por entorno) ---
JWT_SECRET=
DATA_ENCRYPTION_KEY=
PROMPT_ENCRYPTION_KEY=
# Clave del dominio profesional (ES-86): DISTINTA de DATA_ENCRYPTION_KEY, minimo 32 caracteres (recomendado 64 hex). Sin valor en el repositorio.
PROFESSIONAL_ENCRYPTION_KEY=
# PROFESSIONAL_KEY_ID=p1
# Solo durante una rotacion (ver docs/elevation-skillmap/44-ES-86-CLAVE-PROFESIONAL.md):
# PROFESSIONAL_ENCRYPTION_KEY_PREVIOUS=
# PROFESSIONAL_KEY_ID_PREVIOUS=

# --- Análisis de IA del contexto profesional (ES-89; API) ---
# AI_ANALYSIS_TRIGGER=explicit    explicit (la persona lo pide) | automatic (al confirmar el contexto). Pendiente de confirmar por Alejo.

# --- Worker de análisis de IA (ES-87; proceso aparte: node backend/worker.js). NO definir en el API ---
# El worker no debe recibir DATA_ENCRYPTION_KEY, PROMPT_ENCRYPTION_KEY, JWT_SECRET ni DATABASE_URL (se niega a arrancar).
# WORKER_DATABASE_URL=            rol elevation_worker por el pooler compartido
# WORKER_POLL_MS=5000  WORKER_POLL_MAX_MS=30000  WORKER_LEASE_SECONDS=180  WORKER_MAX_ATTEMPTS=3
# WORKER_SHUTDOWN_MS=60000  WORKER_BUDGET_RETRY_SECONDS=900

# --- Modelo ---
ANTHROPIC_API_KEY=
# Opcional: modelo de Claude (por defecto claude-haiku-5-5)
# ANTHROPIC_MODEL=
# --- Presupuesto de IA (ES-22; valores por definir, V-12). Sin AI_BUDGET_TOKENS_PER_USER las llamadas de IA se rechazan ---
AI_BUDGET_TOKENS_PER_USER
# AI_BUDGET_TOKENS_COHORT
# AI_BUDGET_PERIOD  (day | week | month; por defecto month)
# AI_CALL_TIMEOUT_MS  (1000-120000; por defecto 45000)
# AI_MAX_RETRIES  (0-2; por defecto 1)
# Detrás de un proxy (Railway): 1. Sin definir no se confía en X-Forwarded-For
# TRUST_PROXY_HOPS=

# --- Aplicación ---
FRONTEND_URL=
ADMIN_EMAILS=

# --- Opcionales (no verificado si el piloto los usa) ---
# DAILY_API_KEY=
# GCS_KEY_FILE=
# GCS_BUCKET_NAME=

# Base local de Dev y QA (ES-80): `npm run db:local` (sin Docker) o `docker compose up -d`. Ambas usan este mismo puerto.
# DATABASE_URL=postgres://elevation:elevation_local@127.0.0.1:54329/elevation_dev
# DB_SSL=false
